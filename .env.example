# Copy to .env and fill in. Never commit the real .env.

# --- Email notifications ---
# For Gmail, the password must be a 16-char App Password, not your login password.
#
# PREFERRED: store the password in Windows Credential Manager instead of here,
# so it isn't in plaintext. Run this once, as the account BlueIris runs under
# (use `python -m keyring`, not bare `keyring` -- the script isn't always on PATH):
#     python -m keyring set watch-my-door youraddress@gmail.com
# Then leave GMAIL_PASSWORD blank/removed below. The script reads Credential
# Manager first and only falls back to GMAIL_PASSWORD if nothing is stored.
GMAIL_USER=youraddress@gmail.com
GMAIL_PASSWORD=
# One address, or several separated by commas (or semicolons):
#     NOTIFY_EMAIL=me@example.com, partner@example.com
NOTIFY_EMAIL=where-to-send-alerts@example.com
# Optional: override the Credential Manager entry name (default "watch-my-door").
KEYRING_SERVICE=watch-my-door

# --- Ollama ---
# The base /api/chat endpoint on the AI box. Ollama must be bound to 0.0.0.0
# on that box (set OLLAMA_HOST=0.0.0.0) for this to be reachable from here.
OLLAMA_URL=http://your-ollama-host:11434/api/chat

# The custom model built from the Modelfile (ollama create cam-watcher -f Modelfile).
OLLAMA_MODEL=cam-watcher

# Seconds to wait for the vision model to respond before giving up.
OLLAMA_TIMEOUT=120

# How long Ollama keeps the model loaded in GPU memory after each request. The
# intent is to avoid a ~7s model reload when a cold model is hit, though tuning
# this didn't meaningfully change per-alert latency in practice -- treat it as a
# knob to try, not a proven fix. "30m" keeps it warm for a while; "-1" keeps it
# resident permanently (holds the VRAM); "8h" etc. also works.
OLLAMA_KEEP_ALIVE=30m

# --- BlueIris ---
# BlueIris's &ALERT_PATH sometimes arrives as a bare filename with no folder.
# Set this to BlueIris's alert-image storage folder so the script can find the
# file. Find it in BlueIris: Settings (gear) -> Folders -> the "Stored" / alerts
# path. Leave blank if &ALERT_PATH already comes through as a full path.
ALERT_IMAGE_DIR=

# Context window sent with every request. Ollama's own default is 4096, which is
# too small for 4 MP alert frames (~4.7K tokens) and hard-400s the call. This
# overrides any PARAMETER num_ctx baked into the model, so keep it >= 8192.
OLLAMA_NUM_CTX=8192

# Longest edge, in pixels, of the image sent to the model. Full 4 MP frames cost
# ~45s per call on an 8 GB card and OOM when two cameras trigger at once; 1600
# roughly halves both. Set 0 to send the original. Only the copy sent to Ollama
# is resized -- the stored file and the emailed attachment stay full resolution.
MAX_IMAGE_EDGE=1600
